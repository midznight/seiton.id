---
import site from "../data/site.json";
const { demoSite = false } = Astro.props;
const root = demoSite ? site.brand.website : "";
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href={root + "/"}>Seiton.id</a>
        <p style="max-width:320px;margin-top:12px">{site.brand.tagline}<br />{site.brand.description}</p>
      </div>
      <div>
        <strong>Jelajahi</strong>
        <div class="footer-links" style="margin-top:12px">
          <a href={root + "/layanan/"}>Layanan</a>
          <a href={root + "/harga/"}>Harga</a>
          <a href={root + "/contoh/"}>Contoh produk</a>
          <a href={root + "/pendiri/"}>Pendiri</a>
        </div>
      </div>
      <div>
        <strong>Informasi</strong>
        <div class="footer-links" style="margin-top:12px">
          <a href={root + "/tentang/"}>Tentang</a>
          <a href={root + "/kontak/"}>Kontak</a>
          <a href={root + "/ketentuan/"}>Ketentuan</a>
          <a href={root + "/privasi/"}>Privasi</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Seiton.id</span>
      <span>Tersedia secara online di seluruh Indonesia.</span>
    </div>
  </div>
</footer>