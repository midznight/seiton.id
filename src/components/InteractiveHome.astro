<script>
  const moduleButtons = Array.from(document.querySelectorAll("[data-module-choice]"));
  const moduleTitle = document.querySelector("[data-module-title]");
  const moduleDescription = document.querySelector("[data-module-description-output]");
  const moduleDeliverables = document.querySelector("[data-module-deliverables]");
  const moduleLink = document.querySelector("[data-module-link]");
  const moduleMark = document.querySelector("[data-module-mark]");
  const kineticNumber = document.querySelector("[data-kinetic-number]");
  const kineticLabel = document.querySelector("[data-kinetic-label]");
  const kineticBenefit = document.querySelector("[data-kinetic-benefit]");

  const selectModule = (index) => {
    const button = moduleButtons[index];
    if (!button) return;
    moduleButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle("is-selected", active);
      item.setAttribute("aria-pressed", String(active));
    });
    if (moduleTitle) moduleTitle.textContent = button.dataset.moduleName || "";
    if (moduleDescription) moduleDescription.textContent = button.dataset.moduleDescription || "";
    if (moduleLink) moduleLink.href = button.dataset.moduleUrl || "/layanan/";
    if (moduleMark) moduleMark.textContent = String(index + 1).padStart(2, "0");
    if (kineticNumber) kineticNumber.textContent = String(index + 1).padStart(2, "0");
    if (kineticLabel) kineticLabel.textContent = button.dataset.moduleName || "";
    if (kineticBenefit) kineticBenefit.textContent = button.dataset.moduleBenefit || "";
    if (moduleDeliverables) {
      let deliverables = [];
      try { deliverables = JSON.parse(button.dataset.moduleDeliverables || "[]"); } catch {}
      moduleDeliverables.replaceChildren(...deliverables.slice(0, 3).map((value) => {
        const li = document.createElement("li");
        li.textContent = value;
        return li;
      }));
    }
  };

  moduleButtons.forEach((button, index) => {
    button.addEventListener("click", () => selectModule(index));
    button.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const rect = button.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      button.style.transform = "perspective(700px) rotateX(" + (-y * 3).toFixed(2) + "deg) rotateY(" + (x * 3).toFixed(2) + "deg) translateY(-2px)";
    });
    button.addEventListener("pointerleave", () => { button.style.transform = ""; });
  });

  const kineticTrigger = document.querySelector("[data-kinetic-trigger]");
  if (kineticTrigger) {
    kineticTrigger.addEventListener("click", () => {
      const activeIndex = moduleButtons.findIndex((button) => button.getAttribute("aria-pressed") === "true");
      selectModule((activeIndex + 1) % moduleButtons.length);
    });
  }

  const simTabs = Array.from(document.querySelectorAll("[data-sim-tab]"));
  const simPanels = Array.from(document.querySelectorAll("[data-sim-panel]"));
  const activateSimulation = (name, moveFocus = false) => {
    simTabs.forEach((tab) => {
      const active = tab.dataset.simTab === name;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && moveFocus) tab.focus();
    });
    simPanels.forEach((panel) => { panel.hidden = panel.dataset.simPanel !== name; });
  };
  simTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateSimulation(tab.dataset.simTab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % simTabs.length;
      else if (event.key === "ArrowLeft") next = (index - 1 + simTabs.length) % simTabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = simTabs.length - 1;
      else return;
      event.preventDefault();
      activateSimulation(simTabs[next].dataset.simTab, true);
    });
  });

  const comparisonButtons = Array.from(document.querySelectorAll("[data-comparison-mode]"));
  const comparisonPanel = document.querySelector("[data-comparison-panel]");
  const comparisonLabel = document.querySelector("[data-comparison-label]");
  const comparisonTitle = document.querySelector("[data-comparison-title]");
  const comparisonCopy = document.querySelector("[data-comparison-copy]");
  const comparisonPoints = document.querySelector("[data-comparison-points]");
  const beforeSummary = {
    label: "SEBELUM DITATA · SIMULASI",
    title: "Informasi dicari satu per satu.",
    copy: "Pelanggan bertanya melalui chat dan pemilik perlu mencari kembali foto atau informasi yang tersebar.",
    points: ["Foto dan detail berada di beberapa tempat.", "Jawaban yang sama dapat ditanyakan berulang.", "Pemilik menyusun pesan satu per satu."]
  };
  const afterSummary = {
    label: "SESUDAH DITATA · SIMULASI",
    title: "Informasi lebih mudah dibagikan.",
    copy: "Pemilik dapat membagikan tautan katalog atau menu yang sudah disusun, sehingga pelanggan bisa memeriksa informasi yang tersedia.",
    points: ["Daftar produk lebih terstruktur.", "Foto dan informasi tidak perlu dicari satu per satu.", "Pelanggan memiliki satu rujukan untuk informasi tersebut."]
  };
  const setComparisonMode = (mode) => {
    const after = mode === "after";
    if (comparisonPanel) comparisonPanel.dataset.comparisonPanel = mode;
    comparisonButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.comparisonMode === mode)));
    const summary = after ? afterSummary : beforeSummary;
    if (comparisonLabel) comparisonLabel.textContent = summary.label;
    if (comparisonTitle) comparisonTitle.textContent = summary.title;
    if (comparisonCopy) comparisonCopy.textContent = summary.copy;
    if (comparisonPoints) {
      comparisonPoints.replaceChildren(...summary.points.map((point) => {
        const li = document.createElement("li");
        li.textContent = point;
        return li;
      }));
    }
    const messages = document.querySelector("[data-chat-messages]");
    if (messages) {
      messages.innerHTML = after
        ? '<div class="ih-chat-bubble ih-customer-message">Halo, boleh minta daftar produk?</div><div class="ih-chat-bubble ih-business-message">Tentu. Ini tautan etalase kami. Di sana ada daftar produk dan informasinya.</div><div class="ih-chat-share-card"><span class="ih-share-icon">LINK</span><span><b>Etalase Usaha Contoh</b><small>Produk · Informasi · Kontak</small></span><i aria-hidden="true">↗</i></div><div class="ih-chat-bubble ih-customer-message">Terima kasih, saya bisa melihat pilihannya sekarang.</div>'
        : '<div class="ih-chat-bubble ih-customer-message">Halo, boleh minta daftar produk?</div><div class="ih-chat-bubble ih-business-message">Sebentar ya, saya cari foto dan daftar produknya dulu.</div><div class="ih-chat-bubble ih-customer-message">Sekalian harga dan pilihan lainnya ya.</div><div class="ih-chat-bubble ih-business-message">Baik, saya kirim satu per satu.</div>';
    }
  };
  comparisonButtons.forEach((button) => button.addEventListener("click", () => setComparisonMode(button.dataset.comparisonMode)));
  const replayButton = document.querySelector("[data-chat-replay]");
  if (replayButton) {
    replayButton.addEventListener("click", () => {
      const messages = document.querySelector("[data-chat-messages]");
      if (!messages) return;
      messages.classList.remove("is-replaying");
      void messages.offsetWidth;
      messages.classList.add("is-replaying");
      window.setTimeout(() => messages.classList.remove("is-replaying"), 1200);
    });
  }

  const processButtons = Array.from(document.querySelectorAll("[data-process-step]"));
  const processSlider = document.querySelector("[data-process-slider]");
  const processFields = {
    number: document.querySelector("[data-process-number]"),
    title: document.querySelector("[data-process-title]"),
    summary: document.querySelector("[data-process-summary]"),
    owner: document.querySelector("[data-process-owner]"),
    seiton: document.querySelector("[data-process-seiton]")
  };
  const processContent = [
    {
      number: "TAHAP 01",
      title: "Kenali kebutuhan usaha",
      summary: "Ceritakan jenis usaha, masalah yang sedang dihadapi, dan hasil yang ingin dicapai.",
      owner: "Menjelaskan kebutuhan, alur kerja saat ini, dan materi yang sudah tersedia.",
      seiton: "Mendengarkan, memetakan kebutuhan, lalu menjelaskan pilihan serta batas ruang lingkup."
    },
    {
      number: "TAHAP 02",
      title: "Susun sesuai kesepakatan",
      summary: "Setelah ruang lingkup, biaya, dan jadwal disetujui, pengerjaan dimulai dengan bahan yang lengkap.",
      owner: "Menyiapkan foto, logo, daftar produk, harga, informasi usaha, dan akses yang memang diperlukan.",
      seiton: "Menyusun katalog, halaman, atau alur digital sesuai deliverable yang disepakati."
    },
    {
      number: "TAHAP 03",
      title: "Periksa hasil dan serah terima",
      summary: "Hasil diperiksa bersama. Akses dan panduan diserahkan sesuai ruang lingkup pekerjaan.",
      owner: "Memeriksa hasil, memberi umpan balik, dan memastikan informasi usaha sudah benar.",
      seiton: "Menyelesaikan revisi yang termasuk kesepakatan, lalu menyerahkan hasil dan panduan."
    }
  ];
  const selectProcessStep = (index) => {
    const content = processContent[index];
    if (!content) return;
    processButtons.forEach((button) => {
      const active = Number(button.dataset.processStep) === index;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    if (processSlider) processSlider.value = String(index);
    Object.keys(processFields).forEach((key) => {
      if (processFields[key]) processFields[key].textContent = content[key];
    });
  };
  processButtons.forEach((button) => button.addEventListener("click", () => selectProcessStep(Number(button.dataset.processStep))));
  if (processSlider) processSlider.addEventListener("input", () => selectProcessStep(Number(processSlider.value)));

  const blueprintButtons = Array.from(document.querySelectorAll("[data-blueprint-node]"));
  const blueprintNumber = document.querySelector("[data-blueprint-number]");
  const blueprintTitle = document.querySelector("[data-blueprint-title-output]");
  const blueprintDetail = document.querySelector("[data-blueprint-detail-output]");
  blueprintButtons.forEach((button) => {
    button.addEventListener("click", () => {
      blueprintButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
      if (blueprintNumber) blueprintNumber.textContent = button.querySelector("span")?.textContent || "";
      if (blueprintTitle) blueprintTitle.textContent = button.dataset.blueprintTitle || "";
      if (blueprintDetail) blueprintDetail.textContent = button.dataset.blueprintDetail || "";
    });
  });

  const benefitToggles = Array.from(document.querySelectorAll("[data-benefit-toggle]"));
  const setBenefitMode = (toggle, after) => {
    const card = toggle.closest(".ih-benefit-card");
    if (!card) return;
    toggle.setAttribute("aria-pressed", String(after));
    const label = toggle.querySelector("[data-toggle-label]");
    const before = card.querySelector("[data-benefit-before]");
    const afterContent = card.querySelector("[data-benefit-after]");
    if (label) label.textContent = after ? "Sesudah ditata" : "Sebelum ditata";
    if (before) before.hidden = after;
    if (afterContent) afterContent.hidden = !after;
    card.classList.toggle("is-tidied", after);
  };
  benefitToggles.forEach((toggle) => toggle.addEventListener("click", () => {
    setBenefitMode(toggle, toggle.getAttribute("aria-pressed") !== "true");
  }));
  const benefitReset = document.querySelector("[data-benefits-reset]");
  if (benefitReset) benefitReset.addEventListener("click", () => benefitToggles.forEach((toggle) => setBenefitMode(toggle, false)));

  const consultationForm = document.querySelector("#ih-consult-form");
  if (consultationForm) {
    const nameField = consultationForm.querySelector("#ih-business-name");
    const typeField = consultationForm.querySelector("#ih-business-type");
    const needField = consultationForm.querySelector("#ih-business-need");
    const serviceFields = Array.from(consultationForm.querySelectorAll('input[name="requestedService"]'));
    const draft = document.querySelector("#ih-message-draft");
    const sendLink = document.querySelector("#ih-send-whatsapp");
    const copyButton = document.querySelector("#ih-copy-draft");
    const copyStatus = document.querySelector("#ih-copy-status");
    const number = consultationForm.dataset.waNumber || "6288809294868";

    const buildDraft = () => {
      const name = nameField?.value.trim() || "";
      const type = typeField?.value || "Belum ditentukan";
      const selected = serviceFields.filter((field) => field.checked).map((field) => field.value);
      const need = needField?.value.trim() || "";
      const lines = [
        "Halo Seiton.id, saya ingin berkonsultasi tentang kebutuhan digital usaha saya.",
        "",
        "Nama usaha: " + (name || "Belum diisi"),
        "Jenis usaha: " + type,
        "Kebutuhan: " + (selected.length ? selected.join(", ") : "Belum dipilih"),
        "Catatan: " + (need || "Belum ada catatan"),
        "",
        "Mohon bantu saya memahami pilihan solusi yang sesuai. Terima kasih."
      ];
      const message = lines.join("\n");
      if (draft) draft.textContent = message;
      if (sendLink) sendLink.href = "https://wa.me/" + number + "?text=" + encodeURIComponent(message);
      if (copyStatus) copyStatus.textContent = "Draft diperbarui. Periksa kembali sebelum dikirim.";
      return message;
    };
    consultationForm.addEventListener("input", buildDraft);
    consultationForm.addEventListener("change", buildDraft);
    buildDraft();
    if (copyButton) {
      copyButton.addEventListener("click", async () => {
        const message = buildDraft();
        try {
          await navigator.clipboard.writeText(message);
          if (copyStatus) copyStatus.textContent = "Draft berhasil disalin.";
        } catch {
          if (copyStatus) copyStatus.textContent = "Penyalinan otomatis tidak tersedia di browser ini. Pilih teks pada pratinjau untuk menyalinnya.";
        }
      });
    }
  }
</script>