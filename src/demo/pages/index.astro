---
import Base from "../../layouts/Base.astro";
import DemoLabel from "../../components/DemoLabel.astro";
import DemoPreview from "../../components/DemoPreview.astro";
import dataset from "../../data/demo-dataset.json";

const demos = [
  { number: "01", title: "Katalog WhatsApp", kind: "catalog", description: "Susunan 15 produk dengan kategori, foto, dan harga contoh.", href: "/katalog-whatsapp/", label: "Buka katalog" },
  { number: "02", title: "Menu QR", kind: "qr", description: "Halaman menu digital untuk dipindai atau dibagikan.", href: "/menu-qr/", label: "Buka menu QR" },
  { number: "03", title: "Google Business Profile", kind: "profile", description: "Materi dan checklist persiapan, bukan profil bisnis sungguhan.", href: "/google-business-profile/", label: "Buka panduan" },
  { number: "04", title: "Website Profil + Katalog", kind: "website", description: "Website usaha fiktif dengan halaman profil dan katalog.", href: "/website-katalog/", label: "Buka website" },
  { number: "05", title: "Sistem Bot UMKM", kind: "bot", description: "Simulasi keranjang, pesanan, status pembayaran, dan laporan.", href: "/bot-umkm/", label: "Coba bot" },
  { number: "06", title: "Paket Combo", kind: "combo", description: "Gabungan website profil dan katalog dengan sistem bot.", href: "/paket-combo/", label: "Buka Paket Combo" }
];
---
<Base title="Pusat Demonstrasi Seiton.id" description="Pusat demonstrasi produk Seiton.id dengan usaha dan data fiktif." noindex={true} demoSite={true}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">PUSAT DEMONSTRASI</p>
      <h1>Jelajahi bagaimana solusi Seiton.id bekerja.</h1>
      <p class="lead">Semua contoh memakai usaha dan data fiktif. Gunakan demo untuk memahami tampilan dan alur, bukan sebagai tempat transaksi.</p>
      <DemoLabel label="Seluruh data contoh bersifat fiktif" detail="Tidak ada usaha nyata, pembayaran, atau pesan pelanggan yang diproses."/>
    </div>
  </section>
  <section class="section section-white">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">PILIH DEMO</p><h2>Pratinjau solusi yang dapat dijelajahi.</h2></div></div>
      <div class="card-grid demo-grid demo-directory-grid">
        {demos.map((demo) => (
          <article class="card">
            <div class="demo-card-visual"><DemoPreview kind={demo.kind}/></div>
            <div class="demo-card-body">
              <p class="card-kicker">DEMO {demo.number} · FIKTIF</p>
              <h3>{demo.title}</h3>
              <p>{demo.description}</p>
              <a href={demo.href}>{demo.label} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <p class="demo-stat-note">Dataset usaha contoh: {dataset.business}, {dataset.products.length} SKU, periode {dataset.period.label}. Seluruh angka hanya data simulasi.</p>
    </div>
  </section>
</Base>
