---
import Base from "../../../layouts/Base.astro";
import DemoLabel from "../../../components/DemoLabel.astro";
import dataset from "../../../data/demo-dataset.json";
import demoImages from "../../../data/demo-images.json";
const rupiah=(value)=>new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(value);
const groups=["Roti","Pastry & Camilan","Minuman","Paket"].map((category)=>({category,products:dataset.products.filter((product)=>product.category===category)})).filter((group)=>group.products.length);
---
<Base title="Demo Menu QR — Seiton.id" description="Contoh menu QR untuk Kedai Roti & Teh Contoh, usaha fiktif." noindex={true} demoSite={true}>
  <section class="page-hero"><div class="container"><p class="eyebrow">DEMO PRODUK 02</p><h1>Menu digital yang mudah dibuka.</h1><p class="lead">Contoh menu untuk usaha fiktif. QR pada halaman ini mengarah ke demo menu ini, bukan ke toko atau sistem pemesanan sungguhan.</p><DemoLabel/></div></section>
  <section class="section section-white"><div class="container qr-demo-layout">
    <div><p class="eyebrow">KEDAI ROTI &amp; TEH CONTOH</p><h2>Menu dan daftar harga contoh.</h2><p>Scan QR di samping atau buka tautan menu pada ponsel. Semua produk dan harga merupakan data simulasi.</p><div class="actions"><a class="button button-primary" href="/menu-qr/">Buka halaman menu</a><a class="button button-secondary" href="/assets/menu-demo-qr.svg" download>Unduh QR contoh (SVG)</a></div></div>
    <figure class="qr-card"><img src="/assets/menu-demo-qr.svg" width="360" height="360" alt="Kode QR yang membuka demo Menu QR Seiton.id"/><figcaption>QR demo · demo.seiton.biz.id/menu-qr/</figcaption></figure>
  </div></section>
  <section class="section"><div class="container">{groups.map((group)=><section class="qr-menu-group"><div class="section-heading"><h2>{group.category}</h2><span>{group.products.length} pilihan</span></div><div class="qr-menu-grid">{group.products.map((product)=>{const image=demoImages[product.sku];return <article class="qr-menu-item"><div>{image?<img src={image.src} width="640" height="640" alt={image.alt} loading="lazy"/>:<span class="qr-image-placeholder">Foto belum tersedia</span>}</div><section><h3>{product.name}</h3><p>{product.description}</p><strong>{rupiah(product.price)}</strong></section></article>;})}</div></section>)}</div></section>
</Base>
<style>
.qr-demo-layout{display:grid;grid-template-columns:1fr 300px;align-items:center;gap:40px}.qr-card{display:grid;justify-items:center;margin:0;padding:20px;border:1px solid #D1D5DB;border-radius:16px;background:#fff}.qr-card img{width:100%;max-width:250px}.qr-card figcaption{margin-top:10px;color:#6B7280;font-size:.72rem;text-align:center}.qr-menu-group{margin-bottom:45px}.qr-menu-group h2{font-size:1.55rem}.qr-menu-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.qr-menu-item{display:grid;grid-template-columns:112px 1fr;gap:14px;overflow:hidden;padding:12px;border:1px solid #D1D5DB;border-radius:12px;background:#fff}.qr-menu-item>div{overflow:hidden;aspect-ratio:1;border-radius:9px;background:#E7E5E4}.qr-menu-item img{width:100%;height:100%;object-fit:cover}.qr-menu-item h3{margin:0 0 6px;font-size:1rem}.qr-menu-item p{margin:0 0 8px;font-size:.75rem}.qr-menu-item strong{font-size:.85rem}.qr-image-placeholder{display:grid;height:100%;place-items:center;color:#6B7280;font-size:.67rem;text-align:center}@media(max-width:750px){.qr-demo-layout{grid-template-columns:1fr}.qr-card{max-width:300px;margin:auto}}@media(max-width:560px){.qr-menu-grid{grid-template-columns:1fr}.qr-menu-item{grid-template-columns:96px 1fr}}
</style>