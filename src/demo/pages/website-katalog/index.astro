---
import Base from "../../../layouts/Base.astro";
import DemoLabel from "../../../components/DemoLabel.astro";
import dataset from "../../../data/demo-dataset.json";
import demoImages from "../../../data/demo-images.json";
const rupiah=(value)=>new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(value);
const highlights=dataset.products.slice(0,6);
const heroImage=demoImages["RT-001"];
---
<Base title="Kedai Roti & Teh Contoh — Website Profil dan Katalog" description="Contoh website profil dan katalog produk untuk usaha fiktif." noindex={true} demoSite={true}>
  <div class="business-demo">
    <div class="business-demo-banner">CONTOH WEBSITE USAHA FIKTIF · BUKAN KLIEN SEITON.ID</div>
    <nav class="business-nav"><a class="business-brand" href="#beranda">Kedai Roti &amp; Teh Contoh</a><div><a href="#tentang">Tentang</a><a href="#katalog">Katalog</a><a href="#kontak">Kontak</a></div></nav>
    <section class="business-hero" id="beranda"><div><p class="eyebrow">ROTINYA HARI INI</p><h1>Temani harimu dengan roti dan teh.</h1><p>Contoh tampilan website usaha yang memuat profil singkat, katalog produk, dan informasi kontak dalam satu halaman.</p><a class="button button-primary" href="#katalog">Lihat katalog produk</a></div><div class="business-hero-image"><img src={heroImage.src} srcset={heroImage.srcset} sizes="(max-width: 720px) 100vw, 520px" width="640" height="640" alt="Roti sobek cokelat contoh" fetchpriority="high" decoding="async"/></div></section>
    <section class="business-section" id="tentang"><p class="eyebrow">TENTANG USAHA</p><h2>Kenali Kedai Roti &amp; Teh Contoh.</h2><p>Ini adalah narasi contoh untuk memperlihatkan bagaimana pemilik usaha dapat menjelaskan jenis produk dan karakter usahanya. Ganti dengan cerita, alamat, dan informasi yang benar sebelum website digunakan.</p></section>
    <section class="business-section business-catalog" id="katalog"><p class="eyebrow">KATALOG PRODUK</p><h2>Pilihan produk contoh.</h2><p>Nama, harga, dan stok berikut diambil dari dataset fiktif.</p><div class="business-products">{highlights.map((product)=>{const image=demoImages[product.sku];return <article class="business-product"><div class="business-product-img">{image?<img src={image.src} srcset={image.srcset} sizes="(max-width: 480px) calc(100vw - 48px), (max-width: 720px) calc(50vw - 36px), 340px" width="640" height="640" alt={image.alt} loading="lazy" decoding="async"/>:<span>Foto contoh belum tersedia</span>}</div><div><span>{product.category}</span><h3>{product.name}</h3><strong>{rupiah(product.price)}</strong></div></article>;})}</div><p class="business-more"><a href="/bot-umkm/">Lihat simulasi katalog lengkap pada bot →</a></p></section>
    <section class="business-section business-contact" id="kontak"><p class="eyebrow">KONTAK</p><h2>Informasi kontak contoh.</h2><p>Bagian ini merupakan placeholder. Nomor telepon, alamat, jam operasional, dan tautan pemesanan usaha fiktif tidak diaktifkan.</p><div class="business-placeholder">[Nomor WhatsApp usaha] · [Alamat usaha] · [Jam operasional]</div></section>
    <footer class="business-footer">Demo produk oleh Seiton.id · Seluruh informasi usaha contoh bersifat fiktif.</footer>
  </div>
</Base>
<style>
.business-demo{background:#fff;color:#1F2937}.business-demo-banner{padding:9px 15px;background:#FFF4EE;color:#7C2D12;text-align:center;font-size:.7rem;font-weight:800;letter-spacing:.06em}.business-nav{display:flex;min-height:70px;align-items:center;justify-content:space-between;gap:16px;padding:12px max(20px,calc((100% - 1080px)/2));border-bottom:1px solid #E5E7EB}.business-brand{font-weight:850}.business-nav>div{display:flex;gap:18px}.business-nav a{font-size:.85rem}.business-hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:50px;max-width:1080px;margin:auto;padding:70px 24px}.business-hero h1{font-size:clamp(2.3rem,5vw,4.2rem)}.business-hero-image{overflow:hidden;border-radius:20px;aspect-ratio:1;background:#F5F5F4}.business-hero-image img{width:100%;height:100%;object-fit:cover}.business-section{max-width:1080px;margin:auto;padding:65px 24px}.business-section>p:not(.eyebrow){max-width:760px}.business-catalog{background:#F5F5F4;max-width:none;padding-inline:max(24px,calc((100% - 1080px)/2))}.business-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:25px}.business-product{overflow:hidden;border:1px solid #D1D5DB;border-radius:13px;background:#fff}.business-product-img{aspect-ratio:16/10;background:#E7E5E4}.business-product-img img{width:100%;height:100%;object-fit:cover}.business-product-img span{display:grid;height:100%;place-items:center;color:#6B7280;font-size:.8rem}.business-product>div:last-child{padding:15px}.business-product>div:last-child span{color:#B9380C;font-size:.7rem;font-weight:750}.business-product h3{margin:6px 0;font-size:1rem}.business-product strong{font-size:.9rem}.business-more{margin-top:22px}.business-contact{padding-block:60px}.business-placeholder{padding:16px;border:1px dashed #9CA3AF;border-radius:10px;background:#F9FAFB;color:#6B7280}.business-footer{padding:20px;text-align:center;background:#1F2937;color:#D1D5DB;font-size:.75rem}@media(max-width:720px){.business-hero{grid-template-columns:1fr;padding-block:45px}.business-products{grid-template-columns:1fr 1fr}.business-nav{align-items:flex-start;flex-direction:column}.business-nav>div{flex-wrap:wrap}}@media(max-width:480px){.business-products{grid-template-columns:1fr}}
</style>