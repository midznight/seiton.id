---
import Base from "../../../../layouts/Base.astro";
import DemoLabel from "../../../../components/DemoLabel.astro";
import dataset from "../../../../data/demo-dataset.json";
import demoImages from "../../../../data/demo-images.json";
const rupiah=(value)=>new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(value);
---
<Base title="Katalog Kedai Roti & Teh Contoh — Demo" description="Katalog produk dari data fiktif." noindex={true} demoSite={true}>
  <section class="page-hero"><div class="container"><p class="eyebrow">KATALOG · CONTOH</p><h1>Daftar produk contoh.</h1><p class="lead">Nama, foto, harga, kategori, dan stok di bawah merupakan data simulasi yang dapat diganti melalui materi pemilik pada proyek nyata.</p><DemoLabel/><div class="actions"><a class="button button-secondary" href="/website-katalog/">Kembali ke website contoh</a></div></div></section>
  <section class="section section-white"><div class="container"><div class="catalog-grid">{dataset.products.map((product)=>{const image=demoImages[product.sku];return <article class="card catalog-item"><div class="catalog-image">{image?<img src={image.src} srcset={image.srcset} sizes="(max-width: 500px) calc(100vw - 48px), (max-width: 760px) calc(50vw - 36px), 340px" width="640" height="640" alt={image.alt} loading="lazy" decoding="async"/>:<span>Foto belum tersedia</span>}</div><div><p class="card-kicker">{product.category} · {product.sku}</p><h3>{product.name}</h3><p>{product.description}</p><strong>{rupiah(product.price)}</strong></div></article>;})}</div></div></section>
</Base>
<style>
.catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.catalog-item{overflow:hidden;padding:0}.catalog-image{aspect-ratio:16/10;background:#E7E5E4}.catalog-image img{width:100%;height:100%;object-fit:cover}.catalog-image span{display:grid;height:100%;place-items:center;color:#6B7280;font-size:.8rem}.catalog-item>div:last-child{padding:15px}.catalog-item h3{font-size:1rem}.catalog-item p:not(.card-kicker){font-size:.8rem}.catalog-item strong{font-size:.9rem}@media(max-width:760px){.catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:500px){.catalog-grid{grid-template-columns:1fr}}
</style>