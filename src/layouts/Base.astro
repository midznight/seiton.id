---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import { isPreviewBuild } from "../utils/site-urls.js";
import "../styles/site.css";
import "../styles/pages.css";
const { title="Seiton.id — Tata Usahamu, Mudahkan Pelanggan", description=site.brand.description, canonical, noindex=false, demoSite=false }=Astro.props;
const canonicalUrl=canonical||new URL(Astro.url.pathname,demoSite?site.brand.demo:site.brand.website).toString();
---
<!doctype html><html lang="id"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
{!demoSite && !isPreviewBuild && <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-K3LKMTF3"></script>}
{!demoSite && !isPreviewBuild && <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>}
<title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#F7F5EF"/>
<link rel="canonical" href={canonicalUrl}/><meta name="robots" content={noindex || isPreviewBuild ? "noindex, nofollow" : "index, follow"}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Seiton.id"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><meta property="og:image" content="https://seiton.biz.id/og-seiton.svg"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<Header demoSite={demoSite}/><main id="main-content"><slot/></main><Footer demoSite={demoSite}/>
</body></html>