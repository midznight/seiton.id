---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import services from "../data/services.json";
import guides from "../data/guides.json";
import { isPreviewBuild, isProductionBuild } from "../utils/site-urls.js";
import "../styles/site.css";
import "../styles/pages.css";

const {
  title="Seiton.id — Tata Usahamu, Mudahkan Pelanggan",
  description=site.brand.description,
  canonical,
  noindex=false,
  demoSite=false,
  author,
  ogType="website",
  articlePublishedTime,
  articleModifiedTime,
  structuredData=[]
}=Astro.props;
const canonicalUrl=canonical||new URL(Astro.url.pathname,demoSite?site.brand.demo:site.brand.website).toString();

const organizationId = site.brand.website + "#organization";
const websiteId = site.brand.website + "#website";
const whatsappContact = site.contacts.find((contact) => contact.label === "WhatsApp");
const emailContact = site.contacts.find((contact) => contact.label === "Email");
const whatsappNumber = whatsappContact?.url?.match(/^https:\/\/wa\.me\/(\d+)/)?.[1];
const socialProfiles = site.contacts.filter((contact) =>
  ["Instagram", "TikTok", "Threads"].includes(contact.label)
);
const organizationSchema = {
  "@type": "Organization",
  "@id": organizationId,
  name: site.brand.name,
  description: site.brand.description,
  url: site.brand.website,
  logo: {
    "@type": "ImageObject",
    url: site.brand.website + "/logo-horizontal.png",
    width: 640,
    height: 208
  },
  ...(emailContact ? { email: emailContact.value } : {}),
  ...(whatsappContact ? {
    contactPoint: [{
      "@type": "ContactPoint",
      contactType: "customer support",
      ...(whatsappNumber ? { telephone: "+" + whatsappNumber } : {}),
      url: whatsappContact.url,
      availableLanguage: "Indonesian"
    }]
  } : {}),
  sameAs: socialProfiles.map((contact) => contact.url)
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: site.brand.name,
  url: site.brand.website,
  inLanguage: "id-ID",
  publisher: { "@id": organizationId }
};
const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl + "#webpage",
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: "id-ID",
  isPartOf: { "@id": websiteId },
  publisher: { "@id": organizationId }
};

const breadcrumbLabels = {
  layanan: "Layanan",
  harga: "Harga",
  contoh: "Contoh Produk",
  cerita: "Cerita Seiton",
  kontak: "Kontak",
  panduan: "Panduan UMKM",
  "jasa-website-umkm-jember": "Jasa Website UMKM Jember",
  ketentuan: "Ketentuan",
  privasi: "Kebijakan Privasi"
};
const serviceBySlug = new Map(services.map((service) => [service.slug, service.name]));
const guideBySlug = new Map(guides.map((guide) => [guide.slug, guide.title]));
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = pathSegments.length ? [
  { name: "Beranda", url: site.brand.website + "/" },
  ...pathSegments.map((segment, index) => {
    const cumulativePath = "/" + pathSegments.slice(0, index + 1).join("/") + "/";
    const name = serviceBySlug.get(segment)
      || guideBySlug.get(segment)
      || breadcrumbLabels[segment]
      || segment.split("-").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
    return { name, url: site.brand.website + cumulativePath };
  })
] : [];
const breadcrumbSchema = breadcrumbItems.length ? {
  "@type": "BreadcrumbList",
  "@id": canonicalUrl + "#breadcrumb",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.url
  }))
} : null;
const extraSchema = Array.isArray(structuredData)
  ? structuredData
  : structuredData ? [structuredData] : [];
const jsonLd = !demoSite
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        organizationSchema,
        websiteSchema,
        webPageSchema,
        ...(breadcrumbSchema ? [breadcrumbSchema] : []),
        ...extraSchema
      ]
    }).replace(/</g, "\\u003c")
  : "";
const socialImage = site.brand.website + "/og-seiton.svg";
---
<!doctype html><html lang="id"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
{!demoSite && <link rel="stylesheet" href="/analytics-consent.css"/>}
{!demoSite && <script is:inline src="/analytics-consent.js" defer data-analytics-enabled={isProductionBuild ? "true" : "false"}></script>}
<title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#F7F5EF"/>
{author && <meta name="author" content={author}/>}
<link rel="canonical" href={canonicalUrl}/><meta name="robots" content={noindex || isPreviewBuild ? "noindex, nofollow" : "index, follow"}/>
<meta property="og:type" content={ogType}/><meta property="og:locale" content="id_ID"/><meta property="og:site_name" content="Seiton.id"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><meta property="og:image" content={socialImage}/><meta property="og:image:type" content="image/svg+xml"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Seiton.id — katalog, website, dan solusi digital untuk UMKM Indonesia"/>
{ogType === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime}/>}
{ogType === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime}/>}
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="Seiton.id — katalog, website, dan solusi digital untuk UMKM Indonesia"/>
{!demoSite && <script type="application/ld+json" set:html={jsonLd}></script>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<Header demoSite={demoSite}/><main id="main-content"><slot/></main><Footer demoSite={demoSite}/>
</body></html>
