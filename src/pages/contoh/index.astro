---
import Base from "../../layouts/Base.astro";
import DemoPreview from "../../components/DemoPreview.astro";
import { siteUrls } from "../../utils/site-urls.js";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";

const demos = [
  { number: "01", title: "Katalog WhatsApp", kind: "catalog", description: "Susun kategori, foto produk, deskripsi, dan harga agar pelanggan lebih mudah memilih.", href: "/katalog-whatsapp/", label: "Lihat contoh katalog" },
  { number: "02", title: "Menu QR", kind: "qr", description: "Tampilkan menu digital yang dapat dibuka pelanggan dari kode QR atau tautan.", href: "/menu-qr/", label: "Lihat contoh menu" },
  { number: "03", title: "Google Business Profile", kind: "profile", description: "Lihat materi dan checklist informasi usaha yang perlu disiapkan sebelum pengelolaan profil.", href: "/google-business-profile/", label: "Buka panduan" },
  { number: "04", title: "Website Profil dan Katalog", kind: "website", description: "Kenali struktur website usaha dengan informasi profil, produk, dan kontak.", href: "/website-katalog/", label: "Lihat contoh website" },
  { number: "05", title: "Sistem Bot UMKM", kind: "bot", description: "Telusuri simulasi keranjang, pesanan, status pembayaran, bantuan, dan laporan.", href: "/bot-umkm/", label: "Coba simulasi" },
  { number: "06", title: "Paket Combo", kind: "combo", description: "Lihat bagaimana website informasi usaha dipadukan dengan alur pemesanan bot.", href: "/paket-combo/", label: "Lihat paket combo" }
];
---
<Base title="Contoh Produk dan Demo Seiton.id" description="Lihat pratinjau katalog, menu QR, website usaha, dan sistem pemesanan dalam demonstrasi fiktif.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">CONTOH PRODUK</p>
      <h1>Lihat tampilan dan alur sebelum memilih layanan.</h1>
      <p class="lead">Jelajahi pratinjau produk dan simulasi alur Seiton.id. Seluruh usaha, nama produk, dan data pada halaman demo bersifat fiktif; tidak ada transaksi atau pelanggan nyata.</p>
      <div class="actions">
        <a class="button button-primary" href={siteUrls.demo + "/"}>Buka pusat demonstrasi</a>
        <WhatsAppCTA/>
      </div>
    </div>
  </section>
  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">PILIH CONTOH</p><h2>Kenali bentuk solusi yang dapat dibangun.</h2></div>
        <p>Pratinjau ini membantu menjelaskan fungsi. Hasil akhir mengikuti identitas visual, materi, dan ruang lingkup setiap usaha.</p>
      </div>
      <div class="card-grid demo-grid demo-directory-grid">
        {demos.map((demo) => (
          <article class="card">
            <div class="demo-card-visual"><DemoPreview kind={demo.kind}/></div>
            <div class="demo-card-body">
              <p class="card-kicker">DEMO {demo.number} · DATA FIKTIF</p>
              <h3>{demo.title}</h3>
              <p>{demo.description}</p>
              <a href={siteUrls.demo + demo.href}>{demo.label} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <aside class="demo-notice">
        <span aria-hidden="true">ⓘ</span>
        <p><strong>Catatan demonstrasi</strong> Semua contoh menggunakan usaha dan data fiktif. Halaman demo bukan proyek klien, testimoni, atau tempat transaksi.</p>
        <a href="/cerita/">Kenali Seiton.id →</a>
      </aside>
    </div>
  </section>
</Base>
