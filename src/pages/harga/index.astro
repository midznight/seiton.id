---
import Base from "../../layouts/Base.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
---
<Base title="Harga Layanan Seiton.id" description="Informasi harga layanan Seiton.id. Harga tetap ditampilkan dari API resmi; sistem lanjutan menggunakan penawaran tertulis.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">HARGA DAN PENAWARAN</p>
      <h1>Harga jelas untuk layanan yang tersedia. Penawaran terukur untuk sistem khusus.</h1>
      <p class="lead">Harga tetap dimuat langsung dari sumber data resmi. Layanan dengan kebutuhan integrasi khusus dibahas berdasarkan alur usaha, akses, dan biaya pihak ketiga agar tidak ada perkiraan yang dianggap harga final.</p>
    </div>
  </section>
  <section class="section section-white">
    <div class="container">
      <div class="pricing-callout">
        <div>
          <p class="eyebrow">PENAWARAN BERDASARKAN KEBUTUHAN</p>
          <h2>Sistem Bot UMKM &amp; Paket Combo Website + Bot UMKM</h2>
          <p>Keduanya merupakan sistem lanjutan dengan ruang lingkup yang dapat mencakup katalog, pemesanan, panel admin, konfirmasi pembayaran, laporan, dan integrasi. Detail kanal serta komponen ditentukan setelah konsultasi.</p>
        </div>
        <WhatsAppCTA message="Halo Seiton.id, saya ingin meminta penawaran Sistem Bot UMKM atau Paket Combo Website + Bot UMKM."/>
      </div>

      <div class="pricing-section-heading">
        <div>
          <p class="eyebrow">HARGA TETAP</p>
          <h2>Layanan dengan harga yang sudah ditetapkan.</h2>
        </div>
        <p>Harga diperbarui dari API resmi saat halaman dibuka. Produk yang tidak tersedia dan add-on ditampilkan terpisah agar status setiap layanan mudah dibaca.</p>
      </div>
      <p id="price-status" class="price-status" role="status" aria-live="polite">Memuat daftar harga terbaru…</p>
      <div id="price-grid" class="card-grid price-grid" aria-label="Layanan dengan harga tetap"></div>

      <section id="price-unavailable-section" class="price-unavailable-section" hidden aria-labelledby="price-unavailable-title">
        <div class="price-subheading">
          <div><p class="eyebrow">STATUS LAYANAN</p><h2 id="price-unavailable-title">Belum tersedia sementara</h2></div>
          <p>Informasi berikut tetap ditampilkan untuk transparansi, tetapi belum dapat dipesan.</p>
        </div>
        <div id="price-unavailable-grid" class="card-grid price-unavailable-grid"></div>
      </section>

      <section id="price-addons-section" class="price-addons-section" hidden aria-labelledby="price-addons-title">
        <div class="price-subheading">
          <div><p class="eyebrow">LAYANAN TAMBAHAN</p><h2 id="price-addons-title">Add-on yang dapat dipilih</h2></div>
          <p>Tambahan layanan ditampilkan dari sumber data harga yang sama.</p>
        </div>
        <div id="price-addons" class="price-addon-grid"></div>
      </section>

      <div class="pricing-notes">
        <h3>Ketentuan umum</h3>
        <ul>
          <li>Konsultasi awal tidak dikenakan biaya.</li>
          <li>Pekerjaan dimulai setelah ruang lingkup dan biaya disetujui.</li>
          <li>Ketentuan pembayaran standar: DP 50% dan pelunasan 50% setelah pekerjaan selesai, sebelum serah terima akhir.</li>
          <li>Biaya domain, hosting, API, dan layanan pihak ketiga tidak termasuk kecuali tertulis dalam penawaran.</li>
          <li>Harga dan ruang lingkup final mengikuti penawaran tertulis.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
<script>
  const statusNode = document.querySelector("#price-status");
  const grid = document.querySelector("#price-grid");
  const unavailableSection = document.querySelector("#price-unavailable-section");
  const unavailableGrid = document.querySelector("#price-unavailable-grid");
  const addonsSection = document.querySelector("#price-addons-section");
  const addonsNode = document.querySelector("#price-addons");
  const rupiah = new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 });

  function node(tag, value, className) {
    const element = document.createElement(tag);
    element.textContent = String(value ?? "");
    if (className) element.className = className;
    return element;
  }

  function cardFor(item, packageParts, packagePartsReady) {
    const card = node("article", "", "card price-card");
    card.id = item.id || "";
    if (item.id === "paket-website-telegram") card.classList.add("price-card-featured");
    card.append(node("p", item.unggulan ? "Paket gabungan" : "Layanan Seiton", "card-kicker"));
    card.append(node("h3", item.nama));

    if (item.tersedia === false) {
      card.classList.add("price-card-unavailable");
      card.append(node("p", "Belum tersedia sementara", "price-unavailable"));
      card.append(node("p", item.deskripsi || ""));
      return { card, available: false };
    }

    const amount = Number(item.harga);
    if (!Number.isFinite(amount) || amount < 0) return null;
    let description = item.deskripsi || "";
    let features = Array.isArray(item.fitur) ? item.fitur : [];

    if (item.id === "paket-website-telegram") {
      if (packagePartsReady) {
        const unitTotal = packageParts.reduce((total, product) => total + Number(product.harga), 0);
        const difference = Math.abs(amount - unitTotal);
        description = difference === 0
          ? "Paket menggabungkan tiga layanan satuan. Domain tidak termasuk."
          : "Paket menggabungkan tiga layanan satuan. Selisih terhadap total harga satuan: " + rupiah.format(difference) + ". Domain tidak termasuk.";
        features = packageParts.map((product) => product.nama + " — " + rupiah.format(Number(product.harga)));
      } else {
        description = "Paket menggabungkan tiga layanan. Rincian perbandingan harga satuan belum dapat dimuat; silakan konfirmasi melalui WhatsApp.";
        features = [];
      }
    }

    card.append(node("p", description));
    card.append(node("strong", rupiah.format(amount), "price-amount"));
    const list = document.createElement("ul");
    features.forEach((feature) => list.append(node("li", feature)));
    if (features.length) card.append(list);
    const link = node("a", "Tanya layanan", "button button-primary");
    link.href = "https://wa.me/6285117557133?text=" + encodeURIComponent(item.pesan || "Halo Seiton.id, saya ingin bertanya tentang layanan.");
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    card.append(link);
    return { card, available: true };
  }

  async function loadPrices() {
    const controller = new AbortController();
    const timeoutId = window.setTimeout(() => controller.abort(), 12000);
    try {
      const response = await fetch("https://admin.seiton.biz.id/api/pricing", {
        method: "GET", mode: "cors", cache: "no-store", signal: controller.signal
      });
      if (!response.ok) throw new Error("Sumber harga tidak dapat diakses.");
      const data = await response.json();
      if (!Array.isArray(data.produk) || !Array.isArray(data.tambahan) || data.produk.length === 0) {
        throw new Error("Format data harga tidak sesuai.");
      }

      const productById = new Map(data.produk.filter((item) => item && typeof item === "object").map((product) => [product.id, product]));
      const packageParts = ["katalog", "profile", "telegram"].map((id) => productById.get(id));
      const packagePartsReady = packageParts.every((product) => product && Number.isFinite(Number(product.harga)) && Number(product.harga) >= 0);
      const availableFragment = document.createDocumentFragment();
      const unavailableFragment = document.createDocumentFragment();
      let availableCount = 0;
      let unavailableCount = 0;

      data.produk.forEach((item) => {
        if (!item || typeof item !== "object") return;
        const result = cardFor(item, packageParts, packagePartsReady);
        if (!result) return;
        if (result.available) {
          availableFragment.append(result.card);
          availableCount += 1;
        } else {
          unavailableFragment.append(result.card);
          unavailableCount += 1;
        }
      });
      if (availableCount === 0 && unavailableCount === 0) throw new Error("Tidak ada data harga yang valid.");

      const addonFragment = document.createDocumentFragment();
      data.tambahan.forEach((item) => {
        if (!item || typeof item !== "object") return;
        const card = node("article", "", "price-addon");
        card.append(node("h3", item.nama));
        const amount = Number(item.harga);
        if (Number.isFinite(amount) && amount >= 0) card.append(node("strong", rupiah.format(amount)));
        card.append(node("p", [item.satuan, item.catatan].filter(Boolean).join(". ")));
        addonFragment.append(card);
      });

      grid.replaceChildren(availableFragment);
      unavailableGrid.replaceChildren(unavailableFragment);
      unavailableSection.hidden = unavailableCount === 0;
      addonsNode.replaceChildren(addonFragment);
      addonsSection.hidden = addonFragment.childElementCount === 0;
      statusNode.hidden = true;
      statusNode.removeAttribute("data-state");
    } catch (error) {
      grid.replaceChildren();
      unavailableGrid.replaceChildren();
      addonsNode.replaceChildren();
      unavailableSection.hidden = true;
      addonsSection.hidden = true;
      statusNode.hidden = false;
      statusNode.dataset.state = "error";
      statusNode.textContent = "Sumber data harga belum dapat diakses. Silakan hubungi Seiton.id untuk mendapatkan rincian harga terbaru.";
      console.warn("Harga tidak dimuat; angka cadangan tidak ditampilkan.", error);
    } finally {
      window.clearTimeout(timeoutId);
    }
  }

  loadPrices();
</script>
